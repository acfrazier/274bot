// Isolate IPC wire format (v0.1.7): the PLAYER_INFO snapshot posted into
// each JS isolate before its tick, and the shim interact batch forwarded
// back after the tick. FlatBuffers, not JSON: a 50+ isolate wall must not
// pay a stringify/parse per tick.
//
// The Rust side is hand-written against this schema
// (crates/script/src/isolate_fb.rs) so operators never need `flatc` at
// `cargo test` time. Keep the two in sync.
namespace rs2b0t.isolate;

// A game tile {x, z, level}.
table Tile {
  x: int;
  z: int;
  level: int;
}

// One inventory/bank row: the resolved obj name (absent = the host obj
// table has no name for this id — a script query never matches) and a
// count.
table Row {
  name: string;
  count: int;
  id: int;
  ops: [string];
  noted: bool;
  cert: int;
  component_id: int;
  slot: int = -1;
}

// One skill row: index, name, xp, unboosted base, and current effective.
table Stat {
  index: int;
  name: string;
  xp: int;
  base: int;
  effective: int;
}

// A scene entity view (npc / loc / player / ground item): name, tile,
// id, actions, hp-ish flags — not a full entity clone.
table SceneEntity {
  index: int;
  id: int;
  name: string;
  x: int;
  z: int;
  level: int;
  distance: int;
  health: int;
  max_health: int;
  in_combat: bool;
  animating: bool;
  actions: [string];
  reachable: bool;
  reachable_adj: bool;
  combat_level: int;
  target_kind: int;   // 0 none, 1 npc, 2 player
  target_index: int; // -1 when none
}

// One chat modal BUTTON_OK choice.
table ChatOption {
  text: string;
}

// One combat-style varp-select button with its label.
table CombatStyle {
  mode: int;
  label: string;
  component_id: int;
}

// One varp index/value pair (gold, uses, …).
table Varp {
  index: int;
  value: int;
}

// A scene bank booth (a loc with a Use-quickly action).
table Booth {
  x: int;
  z: int;
  level: int;
}

// The nearest Use-quickly booth on the player's plane (Rust-picked).
table NearestBooth {
  x: int;
  z: int;
  level: int;
  name: string;
  op: string;
  id: int;
}

// A packed bank stand the shim walks to / opens.
table BankStand {
  name: string;
  x: int;
  z: int;
  level: int;
  kind: string;    // "booth" | "npc"
  op: int;         // the stand's 1-based access op slot
  choose: string;  // the teller dialog option, deferred
}

// One make/smelt button of a make product (`quantity` -1 = "Make X").
table MakeButton {
  qty: int;
  com_id: int;
}

// One make-X product row from the chat make menu.
table MakeProduct {
  object_id: int;
  name: string;
  buttons: [MakeButton];
}

table SideTabIface {
  index: int;
  id: int;
}

table ChatLine {
  seq: int;
  text: string;
}

// Compact derived reach query: scene origin plus JS-safe u32 bitsets
// and one adjacent-step byte per tile. Index is lx * height + lz,
// matching native ReachFlood. Old buffers omit this table or the
// trailing `step` vector; the isolate treats missing as unavailable.
table Reach {
  available: bool;
  base_x: int;
  base_z: int;
  level: int;
  width: int;
  height: int;
  walkable: [uint];
  reachable: [uint];
  reachable_adj: [uint];
  step: [ubyte];
}

// One selected-world widget text row. Absent from the posted list is not
// a global IfType label — reader.ifText returns null.
table WidgetText {
  component_id: int;
  text: string;
}

// The PLAYER_INFO snapshot posted before each dispatched tick: exactly the
// fields the shim Game/Inventory/Skills/Bank/Banking/EventSignal read and
// nothing else (no World clone). `hold`/`ours` are the guardian's status
// that EventSignal.pending() reads.
//
// Posts are DELTAS: `tick` is always present; every other field is present
// only when it changed vs the last post (the first post — Start / isolate
// spawn — is the keyframe and carries everything). An omitted field is
// NOT an empty value: the isolate keeps its last JS rows/flags for it.
// Packed `banks` are keyframed and re-posted only when the NavWorld
// identity changes, never merely because the stand list is rebuilt
// unchanged.
table Snapshot {
  tick: ulong;
  here: Tile;
  ingame: bool;
  inv: [Row];
  inv_size: int;   // inv-tab slot count (28 bound, 0 tutorial-locked)
  stats: [Stat];
  booths: [Booth];
  nearest_booth: NearestBooth;
  banks: [BankStand];
  bank: [Row];
  bank_side: [Row];
  bank_open: bool;
  bank_loaded: bool;
  hold: bool;
  ours: bool;
  npcs: [SceneEntity];
  locs: [SceneEntity];
  players: [SceneEntity];
  ground: [SceneEntity];
  equipment: [Row];
  chat_open: bool;
  chat_continue: bool;
  chat_text: string;
  chat_options: [ChatOption];
  side_tab: int;
  varps: [Varp];
  combat_styles: [CombatStyle];
  run_energy: int;
  run_enabled: bool;
  retaliate_enabled: bool;
  my_name: string;
  in_combat: bool;
  animating: bool;
  main_modal_id: int;
  chat_modal_id: int;
  make_products: [MakeProduct];
  side_tab_ifaces: [SideTabIface];
  spell_buttons: [CombatStyle];
  chat_lines: [ChatLine];
  bank_note_on: int;
  bank_note_off: int;
  scene_state: int;
  weight: int;
  camera_yaw: int;
  camera_pitch: int;
  teleports_enabled: bool;
  self_slot: int;
  trade_offer_open: bool;
  trade_confirm_open: bool;
  trade_partner: string;
  trade_mine: [Row];
  trade_theirs: [Row];
  trade_side: [Row];
  trade_accept_id: int;
  trade_decline_id: int;
  shop_open: bool;
  shop_stock: [Row];
  bank_generation: ulong;
  count_dialog_open: bool;
  withdraw_x_result_seq: ulong;
  withdraw_x_result: bool;
  withdraw_load_result_seq: ulong;
  withdraw_load_result: bool;
  bank_op_result_seq: ulong;
  bank_op_result: bool;
  reach: Reach;
  attacked_by_player: bool;
  widgets: [WidgetText];
  self_chat: string;
  hint_tile_x: int = -1;
  hint_tile_z: int = -1;
  retaliate_on_com_id: int = -1;
  retaliate_off_com_id: int = -1;
}

// One shim interact request, tagged by `op`:
// "open-booth" | "open-stand" | "walk" | "walk-near" | "walk-nearest-bank" | "walk-to" | "deposit" | "withdraw" | "withdraw-x" | "withdraw-load" | "close"
// | "held" | "npc" | "loc" | "obj" | "player" | "use-on" | "use-widget-on"
// | "continue" | "answer" | "answer-count" | "if-button" | "close-modal" | "side-tab"
// | "wear" | "set-run" | "set-retaliate" | "set-note-mode" | "set-camera-yaw".
// Optional fields are absent (not written) when the request has none.
table Interact {
  op: string;
  x: int;
  z: int;
  level: int;
  kind: string;
  name: string;
  stand_op: int;
  choose: string;
  action: string;
  index: int; // NPC index, or the radius for walk-near.
  component_id: int;
  bank_generation: ulong;
  bank_item_id: int;
  lands_as_id: int;
  source_item_id: int;
  source_item_slot: int;
  target_item_id: int;
  target_item_slot: int;
}

// The tick's shim interact queue, forwarded to the host.
table InteractBatch {
  reqs: [Interact];
}

// One advertised script-local paint control (`Paint.buttons` descriptor).
table PaintButton {
  id: string;
  label: string;
}

// One recorded paint frame (`Paint.begin` … `end()`), isolate→host.
// Same channel as InteractBatch: a typed buffer, never a JSON value.
// `buttons` is optional at the end so older buffers decode as empty.
table Paint {
  title: string;
  accent: string;
  lines: [string];
  buttons: [PaintButton];
}

root_type Snapshot;
