def_locshape $shape = loc_shape;
def_loc $next_loc = lc_param(loc_type, next_loc_stage);
def_loc $opposite_loc = $next_loc;

def_category $category = double_door_open_and_close_right;

def_coord $opposite_coord = loc_coord;
if ($side = ^left) {
    $opposite_coord = ~movecoord_loc_return(~door_close(loc_angle, loc_shape));
    $category = double_door_open_and_close_right;
} else if ($side = ^right) {
    $opposite_coord = ~movecoord_loc_return(~multiply2(~door_close(loc_angle, loc_shape), -1));
    $category = double_door_open_and_close_left;
}

loc_findallzone($opposite_coord);
while (.loc_findnext = true) {
    if (.loc_coord = $opposite_coord & .loc_category = $category) {
        $opposite_loc = lc_param(.loc_type, next_loc_stage);
    }
}

// walk through door, but if entering, walk next to door and then through
$x, $z = ~door_open($angle, loc_shape);
if ($sound ! null) {
    sound_synth($sound, 1, 0);
}
def_coord $dest = $loc_coord;
if ($entering = true) {
    // mes(~coord_tostring($loc_coord));
    // mes(~coord_tostring(coord));
    if (coord ! $loc_coord & coord ! $opposite_coord) {
        p_teleport($loc_coord);
        // initially thought p_delay(0); was the right speed.
        // but it seems to have buggy clipping; you move through too early
        p_delay(1);
    }
    $dest = movecoord($loc_coord, $x, 0, $z);
}
p_teleport($dest);

if ($side = ^left) {
    // Temp note: dur updated
    ~open_double_doors_left2(3, double_door_open_and_close_right, $next_loc, $opposite_loc, null);
} else if ($side = ^right) {
    // Temp note: dur updated
    ~open_double_doors_right2(3, double_door_open_and_close_left, $next_loc, $opposite_loc, null);
}

// doors/scripts/open_and_close_double_doors.rs2:118
[proc,open_and_close_double_door3](boolean $entering, loc $loc_type, locshape $shape, int $angle, coord $loc_coord, int $side, synth $sound)
def_int $x;
def_int $z;

def_loc $next_loc = lc_param($loc_type, next_loc_stage);
def_loc $opposite_loc = $next_loc;

def_category $category = double_door_open_and_close_right;

def_coord $opposite_coord = $loc_coord;
if ($side = ^left) {
    $opposite_coord = ~movecoord_loc_return(~door_close($angle, $shape));
    $category = double_door_open_and_close_right;
} else if ($side = ^right) {
    $opposite_coord = ~movecoord_loc_return(~multiply2(~door_close($angle, $shape), -1));
    $category = double_door_open_and_close_left;
}

loc_findallzone($opposite_coord);
while (.loc_findnext = true) {
    if (.loc_coord = $opposite_coord & .loc_category = $category) {
        $opposite_loc = lc_param(.loc_type, next_loc_stage);
    }
}

// walk through door, but if entering, walk next to door and then through
$x, $z = ~door_open($angle, $shape);
if ($sound ! null) {
    sound_synth($sound, 1, 0);
}
def_coord $dest = $loc_coord;
if ($entering = true) {
    // mes(~coord_tostring($loc_coord));
    // mes(~coord_tostring(coord));
    if (coord ! $loc_coord & coord ! $opposite_coord) {
        p_teleport($loc_coord);
        // initially thought p_delay(0); was the right speed.
        // but it seems to have buggy clipping; you move through too early
        p_delay(1);
    }
    $dest = movecoord($loc_coord, $x, 0, $z);
}
p_teleport($dest);

if ($side = ^left) {
    // Temp note: dur updated
    ~open_double_doors_left2(3, double_door_open_and_close_right, $next_loc, $opposite_loc, null);
} else if ($side = ^right) {
    // Temp note: dur updated
    ~open_double_doors_right2(3, double_door_open_and_close_left, $next_loc, $opposite_loc, null);
}

// doors/scripts/door_procs.rs2:77
[proc,check_axis](coord $coord, coord $loc_coord, int $angle)(boolean)
switch_int($angle) {
    case ^loc_north, ^loc_south :
        if (coordz($coord) = coordz($loc_coord)) {
            return(true);
        }
    case ^loc_west, ^loc_east :
        if (coordx($coord) = coordx($loc_coord)) {
            return(true);
        }
}
return(false);

// doors/scripts/door_procs.rs2:90
[proc,check_axis_locactive](coord $coord)(boolean)
switch_int(loc_angle) {
    case ^loc_north, ^loc_south :
        if (coordz($coord) = coordz(loc_coord)) {
            return(true);
        }
    case ^loc_west, ^loc_east :
        if (coordx($coord) = coordx(loc_coord)) {
            return(true);
        }
}
return(false);

// ladders+stairs/scripts/ladders.rs2:154
[proc,climb_ladder](coord $coord, boolean $up)
if ($up = true) {
    anim(human_reachforladder, 0);
} else {
    anim(human_pickupfloor, 0);
}
p_delay(0);
p_telejump($coord);

// doors/scripts/door_procs.rs2:1
[proc,door_open](int $angle, locshape $shape)(int, int)
if ($shape = wall_straight) {
    switch_int($angle) {
        case ^loc_west : return(-1, 0);
        case ^loc_north : return(0, 1);
        case ^loc_east : return(1, 0);
        case ^loc_south : return(0, -1);
        case default : error("angle not found for door_open: <tostring($angle)>");
    }
}
if ($shape = wall_diagonal) {
    switch_int ($angle) {
        case ^loc_west : return(0, 1);
        case ^loc_north : return(1, 0);
        case ^loc_east : return(0, -1);
        case ^loc_south : return(-1, 0);
        case default : error("angle not found for door_close_diagonal: <tostring($angle)>");
    }
}

// doors/scripts/door_procs.rs2:41
[proc,door_open_mirrored](int $angle)(int, int)
switch_int($angle) {
    case ^loc_west : return(-1, -1);
    case ^loc_north : return(-1, 1);
    case ^loc_east : return(1, 1);
    case ^loc_south : return(1, -1);
    case default : error("angle not found for door_open_mirrored: <tostring($angle)>");
}

// doors/scripts/door_procs.rs2:103
[proc,movecoord_loc_return](int $x, int $z)(coord)
return(movecoord(loc_coord, $x, 0, $z));

// doors/scripts/door_procs.rs2:21
[proc,door_close](int $angle, locshape $shape)(int, int)
if ($shape = wall_straight) {
    switch_int($angle) {
        case ^loc_west : return(0, 1);
        case ^loc_north : return(1, 0);
        case ^loc_east : return(0, -1);
        case ^loc_south : return(-1, 0);
        case default : error("angle not found for door_close: <tostring($angle)>");
    }
}
if ($shape = wall_diagonal) {
    switch_int ($angle) {
        case ^loc_west : return(1, 0);
        case ^loc_north : return(0, -1);
        case ^loc_east : return(-1, 0);
        case ^loc_south : return(0, 1);
        case default : error("angle not found for door_close_diagonal: <tostring($angle)>");
    }
}

// general/scripts/misc/math_procs.rs2:1
[proc,multiply2](int $int1, int $int2, int $m)(int, int)
$int1 = calc($int1 * $m);
$int2 = calc($int2 * $m);
return($int1, $int2);

// doors/scripts/doubledoors.rs2:128
[proc,open_double_doors_left2](int $duration, category $category, loc $next_loc, loc $opposite_next_loc, synth $sound)
def_coord $opposite = ~movecoord_loc_return(~door_close(loc_angle, loc_shape));
if ($sound ! null) {
    sound_synth($sound, 1, 0);
}
loc_del($duration);
loc_add(loc_coord, inviswall, loc_angle, loc_shape, 3);
loc_add(~movecoord_loc_return(~door_open(loc_angle, loc_shape)), $next_loc, calc((loc_angle + 3) % 4), wall_straight, $duration);
loc_findallzone($opposite);
while (loc_findnext = true) {
    if (loc_coord = $opposite & loc_category = $category) {
        loc_del($duration);
        loc_add($opposite, inviswall, loc_angle, loc_shape, 3);
        loc_add(~movecoord_loc_return(~door_open(loc_angle, loc_shape)), $opposite_next_loc, calc((loc_angle + 1) % 4), wall_straight, $duration);
        return;
    }
}

// doors/scripts/doubledoors.rs2:146
[proc,open_double_doors_right2](int $duration, category $category, loc $next_loc, loc $opposite_next_loc, synth $sound)
def_coord $opposite = ~movecoord_loc_return(~multiply2(~door_close(loc_angle, loc_shape), -1));
if ($sound ! null) {
    sound_synth($sound, 1, 0);
}
loc_del($duration);
loc_add(loc_coord, inviswall, loc_angle, loc_shape, 3);
loc_add(~movecoord_loc_return(~door_open(loc_angle, loc_shape)), $next_loc, calc((loc_angle + 1) % 4), wall_straight, $duration);
loc_findallzone($opposite);
while (loc_findnext = true) {
    if (loc_coord = $opposite & loc_category = $category) {
        loc_del($duration);
        loc_add($opposite, inviswall, loc_angle, loc_shape, 3);
        loc_add(~movecoord_loc_return(~door_open(loc_angle, loc_shape)), $opposite_next_loc, calc((loc_angle + 3) % 4), wall_straight, $duration);
        return;
    }
}
