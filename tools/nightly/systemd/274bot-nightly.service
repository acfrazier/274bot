# Nightly VM: one nightly live run (every branch in tools/nightly/branches.conf).
# Install: /etc/systemd/system/274bot-nightly.service (see tools/nightly/README.md).
[Unit]
Description=274bot nightly live-cell run
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bot
Group=bot
WorkingDirectory=/srv/nightly
Environment=NIGHTLY_ROOT=/srv/nightly
Environment=PATH=/home/bot/.cargo/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/274bot-nightly.env
EnvironmentFile=-/srv/nightly/cache-manifest-274.env
ExecStart=/usr/bin/env NIGHTLY_JOB=main /usr/bin/python3 /srv/nightly/runner/tools/nightly/run_nightly.py
ExecStartPost=/usr/bin/env NIGHTLY_JOB=quest NIGHTLY_REVISION=289 NIGHTLY_ENGINE=local NIGHTLY_PROFILE=local-289q NIGHTLY_ENGINE_HOST=127.0.0.1 NIGHTLY_GAME_PORT=44694 NIGHTLY_HTTP_PORT=1180 NIGHTLY_ENGINE_LABEL="Engine Q" NIGHTLY_ENGINE_SCRIPT_REVISION=289q NIGHTLY_RUN_SUFFIX=-quest NIGHTLY_NAME_PREFIX=nq NIGHTLY_PANEL_NAME_PREFIX=nqp NIGHTLY_STEPS=tui NIGHTLY_PARALLEL=1 NIGHTLY_PANEL_PARALLEL=1 /usr/bin/python3 /srv/nightly/runner/tools/nightly/run_nightly.py
TimeoutStartSec=30h
KillMode=mixed
TimeoutStopSec=120
Nice=5
