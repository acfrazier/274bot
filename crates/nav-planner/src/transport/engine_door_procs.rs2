[proc,open_and_close_metal_gate2](loc $replacement, boolean $entering, boolean $mirrored)
// ~loc_shape_debug(loc_shape);
// mes(tostring(loc_angle));
def_int $x;
def_int $z;
def_int $telex;
def_int $telez;

