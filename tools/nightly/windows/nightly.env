# Windows nightly host settings. Copy to C:\274bot-nightly\nightly.env; read by
# nightly-task.ps1 (KEY=VALUE, no quotes). Everything else has a default in
# run_nightly.py (Engine B on 127.0.0.1:47594/3080, prefixes nw/np, deadlines).
NIGHTLY_BRANCHES=dev
NIGHTLY_PARALLEL=4
NIGHTLY_PANEL_PARALLEL=3
NIGHTLY_CELL_CAP_S=1200
# Disk guard: remove a Cargo target folder over the cap before the lanes and
# before the build. The night is UNAVAILABLE when C: still has less free
# space than the floor after that. 0 turns a check off.
NIGHTLY_TARGET_CAP_GB=40
NIGHTLY_MIN_FREE_GB=100
NIGHTLY_PATH_PREPEND=C:\Users\BotTest\.cargo\bin;C:\Program Files\Git\cmd
CARGO_HOME=C:\Users\BotTest\.cargo
RUSTUP_HOME=C:\Users\BotTest\.rustup
# Same native-build inputs as the Windows platform gate (gate.ps1).
RUSTY_V8_ARCHIVE=C:\274bot-nightly\fixtures\rusty_v8_release_x86_64-pc-windows-msvc.lib.gz
# Test lane inputs. The lanes get NAV_PACK, WORLD_NAV_PACK and
# NAV_ARRIVAL_PACK from the nav fixture. They get ENGINE_DIR from the
# pristine engine copy. They get the inspection baseline from the file
# below when it exists. Keep each file in fixtures\ with its sidecars.
NIGHTLY_NAV_FIXTURE=C:\274bot-nightly\fixtures\274bot-289-v17.navpack
NIGHTLY_INSPECT_BASELINE=C:\274bot-nightly\fixtures\inspect.fb
