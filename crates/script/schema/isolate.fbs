// Isolate IPC wire format (v0.1.7): the PLAYER_INFO snapshot posted into
// each JS isolate before its tick, and the shim interact batch forwarded
// back after the tick. FlatBuffers, not JSON: a 50+ isolate wall must not
// pay a stringify/parse per tick.
//
// Rust bindings are checked-in `flatc --rust` output
// (`schema/generated/isolate_generated.rs`), so operators never need
// `flatc` at `cargo test` time. CI regenerates them with flatc 25.12.19.
namespace rs2b0t.isolate;

// A game tile {x, z, level}.
table Tile {
  x: int;
  z: int;
  level: int;
}
// One typed setting pair for a native gather request. kind: 1 text, 2 integer, 3 boolean, 4 string list, 5 tile.
table SettingRow {
  key: string;
  kind: ubyte;
  text: string;
  integer: long;
  flag: bool;
  list: [string];
  tile: Tile;
}

// One inventory/bank row: the resolved obj name (absent = the host obj
// table has no name for this id — a script query never matches) and a
// count.
table Row {
  name: string;
  count: int;
  id: int;
  ops: [string];
  noted: bool;
  cert: int = -1;
  component_id: int = -1;
  slot: int = -1;
}

// One skill row: index, name, xp, unboosted base, and current effective.
table Stat {
  index: int;
  name: string;
  xp: int;
  base: int;
  effective: int;
}

// A scene entity view (npc / loc / player / ground item): name, tile,
// id, actions, hp-ish flags — not a full entity clone.
table SceneEntity {
  index: int;
  id: int;
  name: string;
  x: int;
  z: int;
  level: int;
  distance: int;
  health: int = -1;
  max_health: int = -1;
  in_combat: bool;
  animating: bool;
  actions: [string];
  reachable: bool;
  reachable_adj: bool;
  combat_level: int;
  target_kind: int;   // 0 none, 1 npc, 2 player
  target_index: int = -1; // -1 when none
  // NPC-only packed observation. Omitted on loc/player/ground (reader 0).
  // size < 1 means observation absent; 0,0 with size >= 1 is a valid world tile.
  size: int;
  nx: int; // path-head network SW x
  nz: int; // path-head network SW z
  shape: int; // loc-only placed shape
  angle: int; // loc-only placed rotation
}

// One chat modal BUTTON_OK choice. The component id is the exact button
// identity used by direct catalog callers; Rust machines may answer by index.
table ChatOption {
  text: string;
  com_id: int;
}

// One combat-style varp-select button with its label.
table CombatStyle {
  mode: int;
  label: string;
  component_id: int;
}

// One varp index/value pair (gold, uses, …).
table Varp {
  index: int;
  value: int;
}

// A scene bank booth (a loc with a Use-quickly action).
table Booth {
  x: int;
  z: int;
  level: int;
}

// The nearest Use-quickly booth on the player's plane (Rust-picked).
table NearestBooth {
  x: int;
  z: int;
  level: int;
  name: string;
  op: string;
  id: int = -1;
}

// Compact native bank-booth dest + readiness for one loc identity.
// Native helpers only; not a JS locator.
table BankApproach {
  loc_id: int;
  x: int;
  z: int;
  level: int;
  can_operate: bool;
  dest_ok: bool;
  dest_x: int;
  dest_z: int;
  dest_level: int;
}

// A packed bank stand the shim walks to / opens.
table BankStand {
  name: string;
  x: int;
  z: int;
  level: int;
  kind: string;    // "booth" | "npc"
  op: int;         // the stand's 1-based access op slot
  choose: string;  // the teller dialog option, deferred
}

// One make/smelt button of a make product (`quantity` -1 = "Make X").
table MakeButton {
  qty: int;
  com_id: int = -1;
}

// One make-X product row from the chat make menu.
table MakeProduct {
  object_id: int = -1;
  name: string;
  buttons: [MakeButton];
}

table SideTabIface {
  index: int;
  id: int = -1;
}

table ChatLine {
  seq: int;
  text: string;
  type: int;
  username: string;
}

// Compact derived reach query: scene origin plus JS-safe u32 bitsets
// and one adjacent-step byte plus two u16 dequeue ranks per tile. Index
// is lx * height + lz, matching native ReachFlood. Old buffers omit this
// table or trailing vectors; bounded reach treats missing ranks as
// unavailable rather than falling back to unbounded bits.
table Reach {
  available: bool;
  base_x: int;
  base_z: int;
  level: int;
  width: int;
  height: int;
  walkable: [uint];
  reachable: [uint];
  reachable_adj: [uint];
  step: [ubyte];
  exact_rank: [ushort];
  adjacent_rank: [ushort];
  canlight: [uint];
}

// One selected-world widget text row. Absent from the posted list is not
// a global IfType label — reader.ifText returns null.
table WidgetText {
  component_id: int;
  text: string;
  item_count: int = -1;
}

// One quest-tab text row after Rust resolves its native display colour.
// `component_id` (slot 8) is the walked TYPE_TEXT id — the row's click
// target. Appended, never reordered: an old buffer omits the slot (the
// row has no target), and a present `0` is a real id and is posted. No
// default: an absent slot is not `0`.
table QuestStatus {
  name: string;
  status: string;
  component_id: int = null;
}

// The main modal's paired text walk (Snapshot slot 248). ONE table so a
// delta cannot tear the lines off the root they were walked from: inner
// slot 4 `root` is the same integer the buffer posts as `main_modal_id`
// (Snapshot slot 68), inner slot 6 `texts` is the TYPE_TEXT walk of that
// root in walk order. When the table is present both inner slots are
// written; `{ root: -1, texts: [] }` is an observed closed modal, and an
// OMITTED Snapshot slot is not that object (the isolate keeps its last
// pair). See the Snapshot comment for the delta rules.
table MainModalTexts {
  root: int = -1;
  texts: [string];
}

// One navigator-named gate short (`nav::router::MissingReq::Carry`): an
// `item_req` stack the strict route needed and the player's posted pack could
// not prove. `name` is the host obj table's display name for `id`, absent when
// that table has none — the join is always `id`, never the name, and a missing
// name never drops the row.
table Carry {
  id: int;
  count: int;
  name: string;
}

// One puzzle board observation: the identified piece container's component
// id, its `link_obj_type` slot count, and its stored rows in slot order
// (sparse — an empty slot contributes no row). `component_id: -1` with
// `size: 0` and no rows is the observed closed board. All three fields are
// written whenever the table is present.
table PuzzleBoard {
  component_id: int = -1;
  size: int;
  items: [Row];
}

// One live NPC's projected overlay-canvas box. `points` is sixteen ints
// (x0,y0, ... x7,y7): ground ring first, then the top ring, same winding.
table NpcBox {
  index: int = -1;
  points: [int];
}
// One typed field from a native API session card's published status
// (the Gatherer card, or the combat session card).
table StatusField {
  key: string;
  kind: ubyte; // 1 text, 2 integer, 3 tile, 4 truth.
  text: string;
  integer: long;
  tile: Tile;
  truth: ubyte;
}

// The host's live native API session page: gathering (Snapshot VT 270) and
// combat (Snapshot VT 288) share this shape.
table ApiGather {
  request_id: ulong;
  phase: ubyte; // 1 preparing, 2 running.
  has_status: bool;
  fields: [StatusField];
}

// Retained terminal result for the most recently completed gathering session (Snapshot VT 272).
table ApiGatherOutcome {
  request_id: ulong;
  end: ubyte; // 1 stopped, 2 blocked, 3 refused, 4 failed.
  code: string;
  message: string;
  retryable: bool (deprecated);
  yielded: uint;
  dropped: uint;
  deposited: uint;
  trips: uint;
  xp: int;
}

// Retained terminal result for the most recently completed combat session (Snapshot VT 290).
// reason: the refused/failed reason, the interrupted cause, or a fought report's abort reason.
table ApiCombatOutcome {
  request_id: ulong;
  end: ubyte; // 1 fought, 2 stopped, 3 interrupted, 4 refused, 5 failed.
  reason: string;
  report_end: ubyte; // fought only: 1 killed, 2 target-gone, 3 no-target, 4 budget, 5 died, 6 aborted.
  npc_type: int = -1;
  ticks: ushort;
  swings: ushort;
  casts: ushort;
  damage_taken: ushort;
  food: ubyte;
  prayer_doses: ubyte;
  boost_doses: ubyte;
  antifire_doses: ubyte;
  protect_switches: ubyte;
}

// One progress page for the most recent quest-progress request (Snapshot VT 274).
// Counts are bounded at 999999999 by the progress resolver; -1 means no capture.
table ProgressFlagRow {
  flag: string;
  truth: ubyte; // 1 true, 2 false, 3 unknown.
  count: int = -1;
}

table QuestProgressRow {
  quest: string;
  display: string;
  colour: ubyte; // 1 notStarted, 2 inProgress, 3 complete, 4 unknown.
  stage: string;
  stage_gap: string;
  complete: ubyte; // 1 true, 2 false, 3 unknown.
  rule: string;
  rule_gap: string;
  flags: [ProgressFlagRow];
  evidence_run: ulong;
  evidence_session: ulong;
  evidence_tick: ulong;
  evidence_sequence: ulong;
  journal_read: bool;
  binding: string;
  role: string;
}

table ApiProgress {
  request_id: ulong;
  kind: ubyte; // 1 reading, 2 done, 3 refused.
  reason: string;
  row: QuestProgressRow;
}

// Bounded cancellation reason for the retained host walk outcome.
enum WalkCancelReason:ubyte { None = 0, UserInput = 1 }

// One live projectile's combat-classification inputs. Only the spotanim and
// decoded local-player target are needed by Hunt's borrowed protect frame.
table CombatProjectile {
  spotanim: int;
  target_player_index: int = null;
}

// The PLAYER_INFO snapshot posted before each dispatched tick: exactly the
// fields the shim Game/Inventory/Skills/Bank/Banking/EventSignal read and
// nothing else (no World clone). `hold`/`ours` are the guardian's status
// that EventSignal.pending() reads.
//
// FIELD ORDER = deployed wire slots in crates/script/src/isolate_fb.rs
// (VT_SNAP_*). Do not reorder for logical grouping — e.g. nearest_booth
// follows chat_lines (slot 38), not booths. Regenerating Rust from this file
// without matching those slots would break on-wire compatibility.
//
// Posts are DELTAS: `tick` is always present; every other field is present
// only when it changed vs the last post (the first post — Start / isolate
// spawn — is the keyframe and carries everything). An omitted field is
// NOT an empty value: the isolate keeps its last JS rows/flags for it.
// Packed `banks` are keyframed and re-posted only when the NavWorld
// identity changes, never merely because the stand list is rebuilt
// unchanged.
table Snapshot {
  tick: ulong;
  here: Tile;
  ingame: bool;
  inv: [Row];
  inv_size: int;   // inv-tab slot count (28 bound, 0 tutorial-locked)
  stats: [Stat];
  booths: [Booth];
  banks: [BankStand];
  bank: [Row];
  bank_side: [Row];
  bank_open: bool;
  bank_loaded: bool;
  hold: bool;
  ours: bool;
  npcs: [SceneEntity];
  locs: [SceneEntity];
  players: [SceneEntity];
  ground: [SceneEntity];
  equipment: [Row];
  chat_open: bool;
  chat_continue: bool;
  chat_text: string;
  chat_options: [ChatOption];
  side_tab: int = -1;
  varps: [Varp];
  combat_styles: [CombatStyle];
  run_energy: int;
  run_enabled: bool;
  retaliate_enabled: bool;
  my_name: string;
  in_combat: bool;
  animating: bool;
  main_modal_id: int = -1;
  chat_modal_id: int = -1;
  make_products: [MakeProduct];
  side_tab_ifaces: [SideTabIface];
  spell_buttons: [CombatStyle];
  chat_lines: [ChatLine];
  nearest_booth: NearestBooth;
  bank_note_on: int = -1;
  bank_note_off: int = -1;
  scene_state: int;
  weight: int;
  camera_yaw: int;
  camera_pitch: int;
  teleports_enabled: bool;
  self_slot: int;
  trade_offer_open: bool;
  trade_confirm_open: bool;
  trade_partner: string;
  trade_mine: [Row];
  trade_theirs: [Row];
  trade_side: [Row];
  trade_accept_id: int = -1;
  trade_decline_id: int = -1;
  shop_open: bool;
  shop_stock: [Row];
  // Open/close session identity used to reject stale bank actions.
  bank_generation: ulong;
  count_dialog_open: bool;
  withdraw_x_result_seq: ulong;
  withdraw_x_result: bool;
  withdraw_load_result_seq: ulong;
  withdraw_load_result: bool;
  bank_op_result_seq: ulong;
  bank_op_result: bool;
  reach: Reach;
  attacked_by_player: bool;
  widgets: [WidgetText];
  self_chat: string;
  hint_tile_x: int = -1;
  hint_tile_z: int = -1;
  retaliate_on_com_id: int = -1;
  retaliate_off_com_id: int = -1;
  quest_statuses: [QuestStatus];
  quest_statuses_available: bool = false;
  npc_boxes: [NpcBox];
  npc_boxes_available: bool = false;
  // The shop side interface's own view of the local player's pack
  // (`shop_template_side:inv`, 3823) — the container Sell 1/5/10 act on.
  // `shop_player_available` separates "not decoded this rebuild" (Sell
  // fails closed) from "decoded and empty".
  shop_player: [Row];
  shop_player_available: bool = false;
  // Main-modal skill-multi TYPE_INV rows (anvil Make-N). Distinct from
  // chat `make_products`. `main_make_available` separates "not decoded
  // this rebuild" from "decoded and empty".
  main_make: [Row];
  main_make_available: bool = false;
  // Compact bank dest/readiness. Omitted in a delta is not empty: the
  // native helper keeps its last rows. An explicit empty vector clears.
  bank_approaches: [BankApproach];
  // Bounded native walk outcome for the isolate wait matcher. Omitted on
  // old buffers (seq 0 / failed false): pending waits keep the caller timeout.
  walk_outcome_seq: ulong = 0;
  walk_outcome_generation: ulong = 0;
  walk_outcome_failed: bool = false;
  walk_outcome_x: int = 0;
  walk_outcome_z: int = 0;
  walk_outcome_level: int = 0;
  walk_outcome_radius: int = 0;
  walk_outcome_allow_teleports: bool = false;
  walk_outcome_request_id: ulong = 0;
  // Logical applet size posted as `__rs2b0t_host.canvasRect`. Origin is 0.
  canvas_width: int;
  canvas_height: int;
  /// Local player combat level (`GameSnapshot::local_player.player.combat_level`).
  combat_level: int;
  // Host-authoritative inspect family. Old buffers omit these (seq 0 / ids 0).
  // Latest published calc or host refusal, plus the immediately previous
  // terminal. Membership / accepted / replaced ids are not waiter terminals.
  route_inspect_seq: ulong = 0;
  route_inspect_generation: ulong = 0;
  route_inspect_request_id: ulong = 0;
  route_inspect_ok: bool = false;
  route_inspect_reason: string;
  route_inspect_bank_planned: bool = false;
  route_inspect_ticks: double = 0.0;
  route_inspect_hops: [InspectHop];
  route_inspect_prev_seq: ulong = 0;
  route_inspect_prev_generation: ulong = 0;
  route_inspect_prev_request_id: ulong = 0;
  route_inspect_prev_ok: bool = false;
  route_inspect_prev_reason: string;
  route_inspect_prev_bank_planned: bool = false;
  route_inspect_prev_ticks: double = 0.0;
  route_inspect_prev_hops: [InspectHop];
  route_inspect_running_id: ulong = 0;
  route_inspect_pending_id: ulong = 0;
  // Last request_id the host drained into running or pending.
  route_inspect_accepted_id: ulong = 0;
  // Explicit replace evidence (not inferred from snapshot arrival).
  route_inspect_replaced_id: ulong = 0;
  route_inspect_replaced_prev_id: ulong = 0;
  // Latest host admission refuses for registered tokens that could not
  // reserve a ring/held slot. Identities only; does not overwrite
  // unobserved terminals. Old buffers omit these (0).
  route_inspect_refused_id: ulong = 0;
  route_inspect_refused_id_2: ulong = 0;
  route_inspect_refused_id_3: ulong = 0;
  // Last-seen unobserved obligation count (latest/prev seq>observed + held).
  // Advisory; isolate authorize can lag the host drain.
  route_inspect_unobserved: ulong = 0;
  // One current-plane raw i32 collision grid. Slot 242. Omitted in a delta
  // is keep; first post without the table materializes unavailable.
  collision: Collision;
  // Local decoded face. Slot 244/246. Omitted in a delta is keep.
  // self_target_index default -1 because 0 is a legal NPC index.
  self_target_kind: int = 0;   // 0 none, 1 npc, 2 player
  self_target_index: int = -1;
  // The main modal's paired TYPE_TEXT walk, slot 248 (next after 246).
  // Omitted in a delta is keep — it is NOT a clear, and it is not
  // `{ root: -1, texts: [] }` (that object is an observed closed modal).
  // A present table writes both inner slots; its `root` is the integer
  // this buffer posts as `main_modal_id`, so a text-only change co-posts
  // slot 68 and the page never reads lines under a stale root.
  main_modal_texts: MainModalTexts;
  // The open puzzle board's piece container, slot 250 (next after 248): the
  // first depth-first TYPE_INV with `obj_ops` under the open main modal
  // (`find_inv_component`; the hint panel has no `obj_ops`). A present table
  // always writes `component_id`, `size` (the component's `link_obj_type`
  // length — NOT the row count) and `items` together; `{ component_id: -1,
  // size: 0, items: [] }` is an observed closed board, and an OMITTED
  // Snapshot slot is not that object (the isolate keeps its last board).
  puzzle_board: PuzzleBoard;
  // The board's session identity (ulong, slot 252). It bumps on session
  // open, session close, or a new board component id, and never on a piece
  // move. Posted only together with the table above, in the same buffer as
  // one delta family.
  puzzle_board_generation: ulong;
  // The navigator-named gate shorts of the latest published walk outcome
  // (slot 254, next after 252). Packed with the walk_outcome family and only
  // with it: the ordering is the walk outcome's own. An EMPTY vector is the
  // observed "this outcome names no short" — a routed walk, and a failed walk
  // the relaxed re-run could not diagnose (budget, off-graph, a non-item
  // gate). An OMITTED slot is not that vector: the isolate keeps its last
  // rows, so a clear is never omitted. A `worn_req` alternative is never a
  // short and is never packed here. Dest geometry is not a shopping list:
  // only this vector names one.
  walk_missing_carry: [Carry];
  // Select-only result, distinct from walk/inspect. Index names the immutable
  // selected-world bank catalog supplied to this isolate at Start.
  bank_selection_request_id: ulong = 0;
  bank_selection_generation: ulong = 0;
  bank_selection_index: int = -1;
  // 0 absent, 1 near shortcut, 2 reachable, 3 air fallback, 4 no candidate.
  bank_selection_kind: ubyte = 0;
  // The local player's primary animation id (slot 264; frozen
  // `reader.selfAnim()`, -1 idle). Written on the keyframe and whenever it
  // changes; an omitted slot keeps the last id. The frozen `AttackClock`
  // keys a swing start on this id, not on the `animating` flag above.
  self_anim: int = -1;
  // Slot 266, walk_outcome family: the settled route end is frozen
  // 'blocked' (the player stands next to a last tile the live scene
  // refuses; WalkExecutor.ts:1039-1040, 1092-1094).
  walk_outcome_blocked: bool = false;
  // Item snapshot packet generation, distinct from bank_generation's
  // open/close session. -1 while closed; omitted in a delta means keep.
  bank_snapshot_generation: long = -1;
  api_gather: ApiGather;
  api_gather_outcome: ApiGatherOutcome;
  api_progress: ApiProgress;
  // Monotonic user movement intent, independent of terminal publication.
  user_move_intent_seq: ulong = 0;
  // Part of the walk_outcome family; replacement with None clears it.
  walk_outcome_cancel_reason: WalkCancelReason = None;
  // At most 32 live projectiles aimed at the local player, in client order.
  // Absent in a delta means keep; an empty vector is an observed clear.
  projectiles: [CombatProjectile];
  // Host hash of native modal body texts and option component/text pairs.
  // Unlike chat_text, unrelated chat-ring messages cannot change this page.
  // Omitted deltas retain the last scalar; zero clears an unavailable snapshot.
  chat_page_fingerprint: ulong = 0;
  // Slot 284: `client.side_modal_id` (`modals().side`), -1 none. Grouped with
  // main_modal_id/chat_modal_id in meaning only. With bank_open it tells a
  // posted (possibly empty) bank_side from one not posted yet; never infer
  // that from the vector length. Written on the keyframe and whenever it
  // changes; an omitted delta keeps the last root; old buffers read -1.
  side_modal_id: int = -1;
  // Slot 286: local-player motion. 0 is unknown or unobserved (including old
  // buffers), 1 is stationary, and 2 is moving. Omitted deltas keep the last
  // reported state.
  local_player_motion: ubyte = 0;
  // Slot 288: the host's live combat session page (same shape as api_gather).
  // Absent in a delta keeps the last page; request_id 0 clears it.
  api_combat: ApiGather;
  // Slot 290: retained terminal of the most recent combat session.
  api_combat_outcome: ApiCombatOutcome;
}

table Collision {
  available: bool;
  base_x: int;
  base_z: int;
  level: int;
  width: int;
  height: int;
  flags: [int];
}

// One packed inspect hop (transports only). kind is TransportKind lowercased.
table InspectHop {
  kind: string;
  loc_id: int;
  loc_name: string;
  action: string;
  option: int;
  from_x: int;
  from_z: int;
  from_level: int;
  to_x: int;
  to_z: int;
  to_level: int;
  ticks: int;
}

// Avoid rectangle of an inspect route or a world walk (walk / walk-near).
// level -1 = every plane.
table AvoidRect {
  min_x: int;
  max_x: int;
  min_z: int;
  max_z: int;
  level: int = -1;
  // Additive FlatBuffer catalog reference; absent/empty retain rectangle form.
  // Empty is reserved as the invalid-zone sentinel (never a real catalog id).
  catalog_id: string;
}

// One validated `api.combat.fight` request (Interact op "combat-fight").
// Names are resolved against the slot's selected game data on the host.
table CombatFight {
  target: ubyte; // 1 npc config names, 2 npc type ids, 3 attackers.
  npc_names: [string];
  npc_ids: [int];
  attackers: ubyte; // 1 npcs, 2 players, 3 any.
  pick: ubyte; // 1 nearest, 2 random, 3 lowest health.
  not_targeting_others: bool = true;
  // Search boxes on one level each (catalog_id unused).
  area: [AvoidRect];
  radius: ubyte = 12;
  lost_radius: ubyte = 20;
  style: ubyte; // 1 melee, 2 ranged, 3 magic.
  melee_mode: ubyte; // 0 any, 1 accurate, 2 aggressive, 3 defensive, 4 controlled.
  ranged_mode: ubyte; // 1 accurate, 2 rapid, 3 long range.
  spells: [string];
  has_spells: bool = false;
  fallback_spells: bool = false;
  prayer: bool = true;
  food: bool = true;
  potions: bool = true;
  retaliate: bool = true;
  budget_ticks: ushort = 1500;
}

// One shim interact request, tagged by `op`:
// "open-booth" | "open-stand" | "walk" | "walk-near" | "walk-nearest-bank" | "walk-to" | "deposit" | "withdraw" | "withdraw-x" | "withdraw-load" | "close"
// | "held" | "npc" | "loc" | "obj" | "player" | "use-on" | "use-widget-on"
// | "continue" | "answer" | "answer-count" | "if-button" | "close-modal" | "side-tab"
// | "shop-button" | "make-panel"
// | "wear" | "unequip" | "set-run" | "set-retaliate" | "set-note-mode" | "set-camera-yaw"
// | "note-progress" | "loop-settled" | "wait-enqueued" | "wait-settled"
// | "recovery-anchor" | "recovery-anchor-none" | "key" | "mouse"
// | "inspect-route" | "select-bank" | "run-policy".
// "key": action=DOM key, kind=code (optional), index=1 down / 0 up.
// "mouse": xf/yf=client coordinates as doubles, level=DOM button, index=1 down / 0 up.
// input_identity is the native permit at production (0 when absent).
// Optional fields are absent (not written) when the request has none.
table Interact {
  op: string;
  x: int;
  z: int;
  level: int;
  kind: string;
  name: string;
  stand_op: int = null;
  choose: string;
  action: string;
  index: int = null; // NPC index, or the radius for walk-near.
  component_id: int = null;
  bank_generation: ulong = null;
  bank_item_id: int = null;
  lands_as_id: int = null;
  source_item_id: int = null;
  source_item_slot: int = null;
  target_item_id: int = null;
  target_item_slot: int = null;
  request_id: ulong = 0;
  xf: double = null;
  yf: double = null;
  input_identity: ulong = 0;
  // Packed-nav FindOptions bits. Absent old buffers stay false.
  allow_wilderness: bool = false;
  allow_bank_fetch: bool = false;
  // Inspect-route origin. Walk still uses here from the snapshot.
  from_x: int = 0;
  from_z: int = 0;
  from_level: int = 0;
  // Explicit inspect FindOptions.allow_teleports. Walk still encodes "tele".
  allow_teleports: bool = false;
  avoid: [AvoidRect];
  // Obsolete on inspect-route (leave default 0; do not renumber). Typed
  // inspect-ack still uses this slot for the isolate-applied seq.
  inspect_ack_seq: ulong = 0;
  // Inspect session generation from the applied snapshot. Required on
  // inspect-ack so a caller cannot free terminals from another session.
  inspect_ack_generation: ulong = 0;
  use_mage_bank: bool = false;
  use_zanaris_bank: bool = false;
  // In-Play BroadcastChannel transport. `data` is the bounded native
  // structured-clone codec, never JSON text.
  channel_id: ulong = 0;
  data: [ubyte];
  seq: ulong = 0;
  // Native RunManager.override update. clear=true is override(null).
  // Optional boolean: 0 absent, 1 false, 2 true.
  run_policy_clear: bool = false;
  run_auto_kind: ubyte = 0;
  // Optional energy: 0 absent, 1 integer floor, 2 JavaScript NaN.
  run_energy_kind: ubyte = 0;
  run_energy_min: int = 0;
  // Typed native API controls; settings is present only for gather-run.
  settings: [SettingRow];
  // Per-request named zone exemptions for world walks and inspect-route. The
  // compat JSON surface has no wire field.
  cross: [string];
  // Present only for combat-fight.
  combat: CombatFight;
}

// The tick's shim interact queue, forwarded to the host.
table InteractBatch {
  reqs: [Interact];
}

root_type Snapshot;
