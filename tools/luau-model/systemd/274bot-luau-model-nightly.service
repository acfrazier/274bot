# Linux nightly host (user unit): the nightly full profile runs of tools/luau-model
# (ADR 0017). The script runs every profile one at a time, each in its own
# 16 GB memory scope, and exits non-zero when one does not end clean.
# Install: ~/.config/systemd/user/274bot-luau-model-nightly.service and
# 274bot-luau-model-nightly.timer, change WorkingDirectory and ExecStart to
# your checkout of 274bot, then
#   systemctl --user daemon-reload && systemctl --user enable --now 274bot-luau-model-nightly.timer
# The first summary line names the revision of the checkout. Read the result
# with
#   journalctl --user -u 274bot-luau-model-nightly -n 20
# The raw output of each profile and summary.txt are under
# %h/.local/state/274bot-luau-model/<UTC time>/ (prune old ones by hand).
[Unit]
Description=274bot luau-model nightly profile runs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/274bot
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash %h/274bot/tools/luau-model/nightly.sh
# The 17 profiles take about three minutes in all and at most 9.1 GiB for one
# profile (measured on Linux), plus the build.
TimeoutStartSec=2h
Nice=10
