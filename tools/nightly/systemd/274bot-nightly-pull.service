# Archive host (Proxmox): pull finished nightly runs into the ZFS dataset.
# Install: /etc/systemd/system/274bot-nightly-pull.service, script at
# /usr/local/sbin/274bot-nightly-pull (tools/nightly/cellar-pull.sh).
[Unit]
Description=Pull finished 274bot nightly runs from the nightly VM into ZFS
Wants=network-online.target
After=network-online.target zfs-mount.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/274bot-nightly-pull
Nice=10
IOSchedulingClass=idle
