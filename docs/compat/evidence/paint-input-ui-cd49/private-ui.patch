+    const SETTINGS: &[ScriptSettingInject] = &[
+        ScriptSettingInject { id: "mode", value: ScriptInjectValue::Str("Runner") },
+        ScriptSettingInject { id: "rune", value: ScriptInjectValue::Str("Air") },
+        ScriptSettingInject { id: "partner", value: ScriptInjectValue::Str("paintproof") },
+        ScriptSettingInject { id: "stayInAltar", value: ScriptInjectValue::Bool(false) },
+    ];
+    let mut scenario = alcher_scenario();
+    scenario.name = "paint_buttons_ui";
+    scenario.settings.start_script = Some("NatureCrafter");
+    scenario.settings.script_settings_inject = Some(SETTINGS);
+    scenario
