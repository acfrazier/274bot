# Shared malbec/zinfandel service. The revision-289 quest job runs only when
# NIGHTLY_ENABLE_QUEST=1 is set in malbec's /etc/274bot-nightly.env.
[Unit]
Description=274bot nightly live-cell run
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bot
Group=bot
WorkingDirectory=/srv/nightly
Environment=NIGHTLY_ROOT=/srv/nightly
Environment=PATH=/home/bot/.cargo/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/274bot-nightly.env
EnvironmentFile=-/srv/nightly/cache-manifest-274.env
ExecStart=/usr/bin/env NIGHTLY_JOB=main /usr/bin/python3 /srv/nightly/runner/tools/nightly/run_nightly.py
ExecStartPost=/bin/sh /srv/nightly/runner/tools/nightly/systemd/run-quest-job.sh
TimeoutStartSec=30h
KillMode=mixed
TimeoutStopSec=120
Nice=5
